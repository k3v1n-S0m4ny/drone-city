# Copy to .env (gitignored). Never commit real values.
TARGET_REPO=<bare-repo-name-lowercase>
HUB_HOST=127.0.0.1
HUB_PORT=8787
# Hub machine label for JSONL backfill events (OTel events carry machine.name themselves)
MACHINE_NAME=vps

# Optional: on hub start, backfill sessions already running on this machine from JSONL.
# BACKFILL=1 requires BACKFILL_DIR_PREFIX (only project dirs starting with it are scanned).
BACKFILL=0
# CLAUDE_PROJECTS_DIR=<defaults to ~/.claude/projects>
BACKFILL_DIR_PREFIX=<claude-project-dir-name-prefix>
BACKFILL_MINUTES=120

# Optional: ticket label regex over the project-dir name (group 1 = label).
# TICKET_LABEL_RE=-worktrees-(t\d+)$
